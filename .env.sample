# Copy this file to .env and fill in your own values, then run:
#   python3 -m bot

API_ID=1234567
API_HASH=your_api_hash_here
BOT_TOKEN=123456789:your_bot_token_here
SESSION_STRING=your_assistant_session_string_here
OWNER_ID=123456789

ADMIN_ONLY_MODE=false
DEFAULT_VIDEO_QUALITY=sd_480p
DEFAULT_AUDIO_QUALITY=high

# Bot ko command na mile to assistant account khud chala dega
ASSISTANT_FALLBACK=false
# Har start par OWNER_ID ko DM
STARTUP_NOTIFY=true

# MongoDB URI (e.g. mongodb+srv://...) — khali chhodne par in-memory chalega
MONGO_DB_URI=
# Log Channel / Group ID (e.g. -100123456789) — bot wahan admin hona chahiye
LOG_CHANNEL_ID=
# Local streamer port (0s streaming)
STREAM_PORT=8000

# --- v1.5: streaming + movie search ---
# Video size: sd_360p / sd_480p / hd_720p (Telegram shows max 720p)
# Read-ahead (MB) and shared RAM cache (MB) per playing file
STREAM_PREFETCH_MB=16
STREAM_CACHE_MB=48
# Movie channel(s): -100... or @username, comma separated (optional —
# channels where the assistant is ADMIN are detected automatically)
MOVIE_CHANNELS=
# Background index of the movie channel (new uploads are added instantly)
MOVIE_INDEX_LIMIT=20000
MOVIE_INDEX_REFRESH=600
